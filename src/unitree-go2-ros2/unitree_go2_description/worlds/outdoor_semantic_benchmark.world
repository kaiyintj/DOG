    <!-- A single stationary target keeps the semantic benchmark deterministic. -->
    <actor name="semantic_person_target">
      <pose>6 0 0 0 0 3.14159</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
    </actor>

    <!-- Gazebo actors have no ray collision. This invisible proxy gives the
         Mid360 points at the same location as the rendered person. -->
    <model name="semantic_person_lidar_proxy">
      <static>true</static>
      <pose>6 0 0.85 0 0 0</pose>
      <link name="link">
        <collision name="person_collision">
          <geometry>
